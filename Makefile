# wgc-gba-tx-ui build. Needs: gcc-arm-none-eabi, binutils-arm-none-eabi, libnewlib-arm-none-eabi,
# build-essential, git (and libmgba-dev + python3 for `make test`).
#
#   make                  ROM for the v1.1a cart protocol  -> build/wgc-gba-tx-ui.gba
#   make PROTOCOL=V11B    ROM for v1.1b (2023+) carts
#   make test             run the ROM headless in mGBA and compare cart writes with the stock ROM
#   make visual           golden-image (screenshot) tests, pixel-exact, both protocols
#   make run              open the ROM in mgba-qt
#   make unit             host unit tests of src/core (Unity), both protocols
#   make coverage         unit + gcovr line/branch coverage gate (build/coverage.html)
#   make mutate           mutation testing on the real ARM build (slow; CI job 'mutation')
#   make lint             gcc -fanalyzer + clang-tidy + cppcheck
#   make check            format-check + lint + test-all (what CI and the pre-push hook run)
#   make hooks            enable the repo's git hooks (.githooks/pre-push)

# bash with pipefail so filtered tool output keeps the tool's exit code
SHELL       := /bin/bash
.SHELLFLAGS := -o pipefail -c

PROTOCOL ?= V11A
NAME     := wgc-gba-tx-ui
B        := build
DEPS     := $(B)/deps
TONC     := $(DEPS)/libtonc
CRT      := $(DEPS)/devkitarm-crtls

CC       := arm-none-eabi-gcc
AR       := arm-none-eabi-ar
OBJCOPY  := arm-none-eabi-objcopy
ARCH     := -mcpu=arm7tdmi -mthumb-interwork
# Strict warnings on our code (ENGINEERING.md §2 layer 1); libtonc headers are -isystem so
# third-party code doesn't trip them.
WARN     := -Wall -Wextra -Wshadow -Wconversion -Wsign-conversion -Wcast-align -Wstrict-prototypes \
            -Wmissing-prototypes -Wundef -Wdouble-promotion -Wvla -Wformat=2 -Wnull-dereference -Werror
CFLAGS   := $(ARCH) -O2 -std=gnu17 $(WARN) -ffunction-sections -fdata-sections -isystem $(TONC)/include \
            -DPROTOCOL_$(PROTOCOL)
GCCLIB   := $(dir $(shell $(CC) -mcpu=arm7tdmi -mthumb -print-libgcc-file-name))
LDFLAGS  := $(ARCH) -mthumb -nostartfiles -T ld/gba_cart.ld -Wl,--gc-sections \
            -Wl,--no-warn-rwx-segments -Wl,-Map,$(B)/$(NAME).map

SRC_C    := $(wildcard src/*.c src/core/*.c)
SRC_S    := $(wildcard src/*.s)
OBJS     := $(SRC_C:src/%.c=$(B)/obj/%.o) $(SRC_S:src/%.s=$(B)/obj/%.o)

.PHONY: all deps test test-v11b test-all visual visual-approve baselines unit unit-fast coverage mutate lint lint-one format format-check check hooks run clean
all: $(B)/$(NAME).gba

# ---- third-party: fetched at pinned commits, built here ------------------------------------
$(DEPS)/.stamp: scripts/fetch_deps.sh
	bash scripts/fetch_deps.sh $(DEPS)
	touch $@
deps: $(DEPS)/.stamp

# libtonc minus tte_iohook.c (needs devkitPro's newlib stdio hooks; we don't use printf) and pre1.3
$(B)/libtonc.a: $(DEPS)/.stamp
	@mkdir -p $(B)/tonc
	@set -e; for f in $$(find $(TONC)/src $(TONC)/asm \( -name '*.c' -o -name '*.s' \) | grep -v -e pre1.3 -e tte_iohook); do \
	  mode=-mthumb; case $$f in *.iwram.*|*.s) mode=-marm;; esac; \
	  x=; case $$f in *.s) x="-x assembler-with-cpp";; esac; \
	  $(CC) $(ARCH) -O2 $$mode -I$(TONC)/include $$x -c $$f -o $(B)/tonc/$$(basename $$f).o; \
	done
	$(AR) rcs $@ $(B)/tonc/*.o

$(B)/gba_crt0.o: $(DEPS)/.stamp
	@mkdir -p $(dir $@)
	$(CC) $(ARCH) -marm -x assembler-with-cpp -c $(CRT)/gba_crt0.s -o $@

$(B)/gbafix: $(DEPS)/.stamp
	@mkdir -p $(dir $@)
	gcc -O2 -w -o $@ $(DEPS)/gba-tools/src/gbafix.c

# ---- our code ------------------------------------------------------------------------------
# *.iwram.c: hot code for IWRAM, compiled as 32-bit ARM (the linker script places *iwram.* objects)
# Rebuild when PROTOCOL changes: it isn't a file, so -MMD can't see it (chunk2 review F6)
$(B)/.protocol-$(PROTOCOL):
	@mkdir -p $(B)
	@for f in $(B)/.protocol-*; do [ -f "$$f" ] && unlink "$$f"; done; true
	@touch $@

$(B)/obj/%.iwram.o: src/%.iwram.c $(DEPS)/.stamp $(B)/.protocol-$(PROTOCOL)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -marm -c $< -o $@

$(B)/obj/%.o: src/%.c $(DEPS)/.stamp $(B)/.protocol-$(PROTOCOL)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -mthumb -c $< -o $@

# Header dependencies generated by -MMD (any edited header rebuilds what includes it)
-include $(OBJS:.o=.d)

$(B)/obj/%.o: src/%.s
	@mkdir -p $(dir $@)
	$(CC) $(ARCH) -x assembler-with-cpp -c $< -o $@

$(B)/$(NAME).elf: $(B)/gba_crt0.o $(OBJS) $(B)/libtonc.a ld/gba_cart.ld
	$(CC) $(LDFLAGS) $(B)/gba_crt0.o $(GCCLIB)crti.o $(GCCLIB)crtbegin.o $(OBJS) \
	  -L$(B) -ltonc $(GCCLIB)crtend.o $(GCCLIB)crtn.o -o $@

$(B)/$(NAME).gba: $(B)/$(NAME).elf $(B)/gbafix
	$(OBJCOPY) -O binary $< $@
	$(B)/gbafix $@ -tWGC.TX.UI -cWGCU -m01 >/dev/null
	@echo "built $@ ($(PROTOCOL), $$(stat -c%s $@) bytes)"

# ---- test harness --------------------------------------------------------------------------
$(B)/emu_harness: tools/emu_harness.c
	@mkdir -p $(dir $@)
	gcc -O2 -o $@ $< -lmgba

# test: v1.1a build vs v1.1a stock recordings. test-all: also a v1.1b build (in build/v11b).
test: $(B)/$(NAME).gba $(B)/emu_harness
	python3 tests/run_tests.py $(B)/emu_harness $(B)/$(NAME).gba v1.1a

# The v1.1b ROM is one file target shared by test-v11b and visual, so make -j can't race on it.
$(B)/v11b/$(NAME).gba: $(SRC_C) $(SRC_S) $(wildcard src/*.h src/core/*.h) ld/gba_cart.ld $(DEPS)/.stamp
	$(MAKE) --no-print-directory B=$(B)/v11b DEPS=$(DEPS) PROTOCOL=V11B $(B)/v11b/$(NAME).gba

test-v11b: $(B)/emu_harness $(B)/v11b/$(NAME).gba
	python3 tests/run_tests.py $(B)/emu_harness $(B)/v11b/$(NAME).gba v1.1b

test-all: test test-v11b

# Golden-image tests (pixel-exact, tests/visual/golden/<ver>/). visual-approve only after looking.
visual: $(B)/$(NAME).gba $(B)/v11b/$(NAME).gba $(B)/emu_harness
	python3 tests/visual.py $(B)/emu_harness $(B)/$(NAME).gba v1.1a
	python3 tests/visual.py $(B)/emu_harness $(B)/v11b/$(NAME).gba v1.1b

# make visual-approve [SCREEN=pairing,dpad]: copies only captures that changed (after you looked)
visual-approve: $(B)/$(NAME).gba $(B)/v11b/$(NAME).gba $(B)/emu_harness
	python3 tests/visual.py $(B)/emu_harness $(B)/$(NAME).gba v1.1a --approve --screen=$(SCREEN)
	python3 tests/visual.py $(B)/emu_harness $(B)/v11b/$(NAME).gba v1.1b --approve --screen=$(SCREEN)

# Re-record tests/baselines/ from the stock ROMs (local only: reference/ is not in the repo)
baselines: $(B)/emu_harness
	python3 tests/record_baselines.py $(B)/emu_harness reference/stock-rom/GBA_TX_Cart_ROM_v1.1a.gba \
	  reference/stock-rom/GBA_TX_Cart_ROM_v1.1b.gba

# ---- host unit tests (ENGINEERING.md §3): src/core is pure C, built for the PC -------------
UNITY     := $(DEPS)/unity/src
CORE_SRC  := $(wildcard src/core/*.c)
UNIT_SRC  := $(wildcard tests/unit/test_*.c)
HOST_CC   := gcc
HOST_FLAGS = -std=gnu17 -O0 -g $(WARN) -Wno-missing-prototypes -Isrc -I$(UNITY)

# build-unit,PROTO,TEST,DIR,EXTRA: compile one test binary. Sources go through realpath, so B and
# DEPS may be relative or absolute (chunk2 review F1: '$(CURDIR)/' broke absolute DEPS). Exit 200 if
# anything fails to compile: a value no test binary returns (Unity exits with its failure COUNT).
define build-unit
d=$(3); mkdir -p $$d; objs=; \
for f in $(2) $(CORE_SRC) $(UNITY)/unity.c; do o=$$d/$$(basename $$f .c).o; \
  $(HOST_CC) $(HOST_FLAGS) $(4) -DPROTOCOL_$(1) -c $$(realpath $$f) -o $$o || exit 200; objs="$$objs $$o"; done; \
$(HOST_CC) $(4) -o $$d/$$(basename $(2) .c) $$objs || exit 200
endef

# Every test binary is built for both protocols (constants differ: split, limits, XY default).
unit: $(DEPS)/.stamp
	@mkdir -p $(B)/unit && find $(B)/unit -name '*.gcda' -delete
	@set -e; for proto in V11A V11B; do for t in $(UNIT_SRC); do \
	  n=$$(basename $$t .c); \
	  $(call build-unit,$$proto,$$t,$(abspath $(B))/unit/$$proto/$$n,--coverage); \
	  (cd $$d && ./$$n) > $$d/out.txt || { cat $$d/out.txt; echo "unit: $$proto $$n FAILED"; exit 1; }; \
	  echo "unit: $$proto  $$(grep -E '^[0-9]+ Tests' $$d/out.txt)  $$n"; \
	done; done

# For mutation testing: only the unit tests in UNIT_TESTS, no coverage, 10 s timeout per binary.
# The outcome goes in $(B)/unit-fast/result: 0 = pass, 1 = a test failed, 124 = timed out,
# 200 = didn't compile, 3 = infrastructure problem (timeout's own 125-127). A crash (128+signal, e.g.
# a mutant that segfaults) is a test failure = 1. Two traps handled here: make exits 2 for ANY
# failing recipe (so its own exit code is useless), and a Unity binary exits with its number of
# FAILED tests, so "2 tests failed" used to look like the old compile-error code 2 (re-check F1).
UNIT_TESTS ?= $(UNIT_SRC)
unit-fast: $(DEPS)/.stamp
	@mkdir -p $(B)/unit-fast; \
	( for proto in V11A V11B; do for t in $(UNIT_TESTS); do \
	    n=$$(basename $$t .c); \
	    $(call build-unit,$$proto,$$t,$(abspath $(B))/unit-fast/$$proto/$$n,); \
	    timeout 10 $$d/$$n > $$d/out.txt; rc=$$?; \
	    if [ $$rc -eq 124 ]; then exit 124; \
	    elif [ $$rc -ge 125 ] && [ $$rc -le 127 ]; then exit 3; \
	    elif [ $$rc -ne 0 ]; then exit 1; fi; \
	  done; done ); echo $$? > $(B)/unit-fast/result

# Coverage gated per protocol: pooling V11A + V11B could hide a branch only one reaches (chunk2 F6).
COV_LINE   ?= 100
COV_BRANCH ?= 100
coverage: unit
	@for proto in V11A V11B; do echo "coverage: $$proto"; \
	  gcovr -r . --object-directory $(B)/unit/$$proto --filter 'src/core/' --exclude-unreachable-branches \
	    --print-summary --fail-under-line $(COV_LINE) --fail-under-branch $(COV_BRANCH) \
	    --html-details $(B)/coverage_$$proto.html -s | tail -3 || exit 1; done

# ---- mutation testing (ENGINEERING.md §4) ---------------------------------------------------
# Mutates src/link.c + src/core/*.c, rebuilds the real ARM ROM per mutant, and runs unit tests
# (both protocols) + the v1.1a emulator suite. Fails if any mutant survives. ~4-6 min.
MUTATE_SRC ?= src/link.c src/main.c $(CORE_SRC) src/core/keyword.h   # reviews: pairing.c, main.c, keyword.h were missed
mutate: $(B)/emu_harness $(DEPS)/.stamp
	python3 tests/mutate.py $(MUTATE_SRC)

# ---- static analysis / style (ENGINEERING.md §2) ------------------------------------------
LINT_SRC  := $(SRC_C)
LINT_DEFS := -DPROTOCOL_$(PROTOCOL)
TIDY_ARGS := --target=armv4t-none-eabi -mthumb -std=gnu17 -isystem $(TONC)/include -isystem /usr/include/newlib $(LINT_DEFS)
FMT_SRC   := $(wildcard src/*.c src/*.h src/core/*.c src/core/*.h tests/unit/*.c) tools/emu_harness.c

lint: $(DEPS)/.stamp
	@$(MAKE) --no-print-directory -s lint-one PROTOCOL=V11A
	@$(MAKE) --no-print-directory -s lint-one PROTOCOL=V11B
	@echo "lint: OK (V11A + V11B, sources and tests)"

lint-one: $(DEPS)/.stamp
	@echo "lint: $(PROTOCOL) gcc -fanalyzer"
	@# -Wno-analyzer-use-of-uninitialized-value: GCC 13 false positive on memcpy from a fully
	@# string-initialised char array (main.c at()/buf, checked by hand 2026-11-14). ENGINEERING.md §2.
	@for f in $(LINT_SRC); do $(CC) $(ARCH) -mthumb -O2 -std=gnu17 $(WARN) -fanalyzer \
	  -Wno-analyzer-use-of-uninitialized-value -isystem $(TONC)/include \
	  $(LINT_DEFS) -c $$f -o /dev/null || exit 1; done
	@echo "lint: clang-tidy"
	@# "N warnings generated" counts third-party header warnings that HeaderFilterRegex hides
	@clang-tidy --quiet $(LINT_SRC) -- $(TIDY_ARGS) 2>&1 | { grep -v -e 'warnings generated' -e '^\[[0-9]*/[0-9]*\] Processing' || true; }
	@echo "lint: clang-tidy (unit tests, $(PROTOCOL))"
	@clang-tidy --quiet $(UNIT_SRC) -- -std=gnu17 -Isrc -I$(UNITY) $(LINT_DEFS) \
	  2>&1 | { grep -v -e 'warnings generated' -e '^\[[0-9]*/[0-9]*\] Processing' || true; }
	@echo "lint: cppcheck"
	@cppcheck -q --std=c11 --enable=warning,style,performance,portability --inline-suppr --error-exitcode=1 \
	  --suppress=missingIncludeSystem --suppress='*:$(DEPS)/*' $(LINT_DEFS) -I src -I $(TONC)/include src/
	@echo "lint: $(PROTOCOL) OK"

format:
	clang-format -i $(FMT_SRC)

format-check:
	@clang-format --dry-run --Werror $(FMT_SRC) && echo "format: OK"

# Everything CI and the pre-push hook run
check: format-check lint coverage test-all visual

# Use the repo's git hooks (pre-push runs `make check`)
hooks:
	git config core.hooksPath .githooks && echo "hooks: core.hooksPath = .githooks"

run: $(B)/$(NAME).gba
	/usr/games/mgba-qt $< &

clean:
	rm -rf $(B)/obj $(B)/tonc $(B)/*.o $(B)/*.a $(B)/*.elf $(B)/*.gba $(B)/*.map $(B)/gbafix $(B)/emu_harness \
	  $(B)/unit $(B)/unit-fast $(B)/.protocol-* $(B)/coverage* $(B)/v11b $(B)/mutate* $(B)/shots $(B)/visual
